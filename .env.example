# v0.5 application template. No real secrets. Copy to APP ROOT as .env.local.
# Actual local configuration belongs in .env.local; this file is only a template.
APP_ORIGIN=http://localhost:3000
SQLITE_FILE=./data/snail.db

# Safe default: no automatic paid requests, including during install/build/tests.
LLM_MODE=mock
AI_LIVE_ENABLED=false
LLM_PROVIDER=deepseek
LLM_API_STYLE=openai_chat_completions
LLM_BASE_URL=https://api.deepseek.com
LLM_API_PATH=/chat/completions
# Sole credential variable in v0.5. Do not also configure LLM_API_KEY/OPENAI_API_KEY.
DEEPSEEK_API_KEY=
LLM_MODEL_INTERPRETER=deepseek-flash
LLM_MODEL_NARRATOR=deepseek-flash
LLM_OUTPUT_MODE=json_object

# Explicitly override the provider's default thinking-on behavior for game turns.
# Project recommendation, not a requirement imposed by the provider.
DEEPSEEK_THINKING_INTERPRETER=disabled
DEEPSEEK_THINKING_NARRATOR=disabled
# Send this field ONLY when the selected role's thinking mode is enabled.
DEEPSEEK_REASONING_EFFORT=high

# Adjustable engineering limits; NOT measured latency or DeepSeek account quotas.
LLM_INTERPRETER_TIMEOUT_MS=12000
LLM_CUSTOM_TIMEOUT_MS=45000
LLM_CUSTOM_MAX_OUTPUT_TOKENS=4096
LLM_CUSTOM_MAX_ATTEMPTS=3
LLM_CUSTOM_TOTAL_TIMEOUT_MS=90000
LLM_NARRATOR_TIMEOUT_MS=20000
LLM_MAX_OUTPUT_TOKENS_INTERPRETER=512
LLM_MAX_OUTPUT_TOKENS_NARRATOR=1024
LLM_MAX_ATTEMPTS_PER_REQUEST=1
LLM_GLOBAL_MAX_CONCURRENCY=4
LLM_PRINCIPAL_MAX_CONCURRENCY=1
# 0 DISABLES live game calls; it never means unlimited. Owner must set a budget.
LLM_GLOBAL_DAILY_CALL_LIMIT=0
LLM_PRINCIPAL_DAILY_CALL_LIMIT=120
LLM_LOG_RAW_PAYLOADS=false

GUEST_SESSION_DAYS=30
FEATURE_ZHIHU_API=false
FEATURE_ZHIHU_OAUTH=false
FEATURE_PLAYER_SCENARIO_GENERATION=false
FEATURE_RUNTIME_IMAGE_GENERATION=false

# Explicit live-generation gate. start:live enables it only for the local demo.
# Numeric amount is the cumulative ledger ceiling in CNY; unlimited is an explicit opt-in.
LLM_BUDGET_YUAN=10

# Zhihu hackathon login: set these only in your local/deployment server secrets.
# App Key is NOT Access Secret. Never share either in chat.
ZHIHU_OAUTH_APP_ID=
ZHIHU_OAUTH_APP_KEY=
# Must exactly match the registered HTTPS callback and APP_ORIGIN:
ZHIHU_OAUTH_REDIRECT_URI=
